{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "u-wash",
  "version": "0.1.2",
  "identifier": "com.uwash.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:8766",
    "devUrl": "http://127.0.0.1:8766",
    "beforeDevCommand": "npm run prepare:tauri",
    "beforeBuildCommand": "npm run prepare:tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/uwash-server"],
    "resources": ["resources/public", "resources/vbcable"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
